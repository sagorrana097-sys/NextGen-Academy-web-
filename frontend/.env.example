# NextGen Academy Frontend Environment Variables (Vercel / Local)

# Production Backend API URL
VITE_API_URL=http://localhost:5000/api
# In production on Vercel, set to:
# VITE_API_URL=https://your-backend-name.onrender.com/api

# Direct Browser-to-Supabase Storage Upload (Bypasses backend server size limits)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_SUPABASE_STORAGE_BUCKET=book-files

# NextGen Academy Backend Environment Configuration
PORT=5000
NODE_ENV=production

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated for multiple domains)
CORS_ORIGIN=http://localhost:5173,https://your-domain.vercel.app

# Database & Storage
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=

# Google Cloud / Gemini AI (Optional for Question Generation)
GEMINI_API_KEY=
